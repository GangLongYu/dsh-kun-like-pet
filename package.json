{
  "name": "dsh-kun-like-pet",
  "version": "2.1.0",
  "private": false,
  "description": "Kun Like 桌宠 —— 可安装的 DeepSeek Harness 静态 bundle 插件",
  "type": "module",
  "main": "./plugin/lib/index.js",
  "exports": {
    ".": {
      "default": "./plugin/lib/index.js"
    },
    "./client": {
      "default": "./plugin/lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "desktop-pet",
    "kun",
    "桌宠"
  ],
  "license": "MIT",
  "author": "liyupi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GangLongYu/dsh-kun-like-pet.git"
  },
  "files": [
    "plugin/lib",
    "plugin/src",
    "plugin/tsconfig.json",
    "plugin/tsdown.config.ts",
    "assets",
    "docs",
    "demo",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown --config plugin/tsdown.config.ts",
    "test": "node scripts/validate.mjs && node scripts/validate-bundle.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "engines": {
    "dsh": "^0.2.0-rc.2",
    "node": ">=22.19"
  }
}
